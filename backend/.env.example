# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED: generate with → python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MINIMUM_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=your@email.com

# ── AI — Anthropic (Option 1) ─────────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── AI — OpenRouter FREE (Option 2, recommended) ──────────────────────────────
# Free models available: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── Market Data APIs ──────────────────────────────────────────────────────────
# TwelveData — forex + stocks: https://twelvedata.com
TWELVE_DATA_API_KEY=
# Polygon.io — US stocks: https://polygon.io
POLYGON_API_KEY=
# Alpha Vantage — fallback: https://alphavantage.co
ALPHA_VANTAGE_API_KEY=
# NewsAPI — sentiment feed: https://newsapi.org
NEWS_API_KEY=

# ── Email — Gmail SMTP ────────────────────────────────────────────────────────
# Setup: Gmail → Security → 2FA ON → App Passwords → Generate 16-char password
GMAIL_USER=your@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx
CONTACT_EMAIL=your@gmail.com

# ── Email — Password Reset ────────────────────────────────────────────────────
# Web3Forms key for EmailJS integration: https://web3forms.com
# WARNING: Never hardcode this — always set via environment variable
WEB3FORMS_KEY=
FRONTEND_URL=https://your-app.vercel.app
