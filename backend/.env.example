# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL (production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── AI (Claude via Anthropic) ─────────────────────────────────────────────────
# Option 1: Anthropic direct (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# ── AI (OpenRouter — FREE tier available) ─────────────────────────────────────
# Option 2: OpenRouter — free models available (https://openrouter.ai/keys)
# Free models: meta-llama/llama-3.3-8b-instruct:free
#              mistralai/mistral-7b-instruct:free
#              google/gemma-3-27b-it:free
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free

# ── Email (Gmail SMTP — free, no extra package) ───────────────────────────────
# Setup: Gmail → Security → 2-Step Verification ON → App Passwords → Generate
# Use the 16-character app password (not your Gmail login password)
GMAIL_USER=memonbisma22@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx
CONTACT_EMAIL=memonbisma22@gmail.com
# Twelve Data  — forex + commodities  (https://twelvedata.com)
TWELVE_DATA_API_KEY=

# Alpha Vantage — stocks + indices    (https://alphavantage.co)
ALPHA_VANTAGE_API_KEY=

# News API      — sentiment feed      (https://newsapi.org)
NEWS_API_KEY=
